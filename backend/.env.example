# API keys
COHERE_API_KEY=
GROQ_API_KEY=

# MongoDB (MONGODB_URI / MONGODB_DATABASE are also supported)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=bank_analyzer

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT for API sessions after Google login (use a long random string in production)
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=10080
